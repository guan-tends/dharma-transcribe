# Dharma Transcription Pipeline — Environment Variables
# Copy to .env and fill in your values. See .gitignore — .env is never committed.

# --- Required for LLM correction (Stage 6) ---
# Any OpenAI-compatible API endpoint. Examples:
#   Synthetic.new: https://api.example.com/v1
#   OpenAI:        https://api.openai.com/v1
#   Ollama (local): http://localhost:11434/v1
#   vLLM (local):  http://localhost:8000/v1
#   LM Studio:     http://localhost:1234/v1
DHARMA_LLM_API_URL=https://api.example.com/v1
DHARMA_LLM_API_KEY=your-api-key-here
DHARMA_LLM_MODEL=hf:openai/gpt-oss-120b

# --- Required for diarization (Stage 4) ---
# HuggingFace token for pyannote speaker-diarization-community-1 model.
# Without this, diarization is skipped (transcription still completes).
# Get one at: https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_token_here

# --- Optional overrides ---
# Compute device: "cuda" (GPU) or "cpu"
# DHARMA_DEVICE=cuda

# WhisperX model size: large-v3, large-v2, medium, small, etc.
# DHARMA_WHISPER_MODEL=large-v3

# Compute type: int8, float16, int8_float16, etc.
# DHARMA_COMPUTE_TYPE=int8

# Batch size for WhisperX transcription
# DHARMA_BATCH_SIZE=4

# Tibetan second-pass model (OpenPecha dharma-trained)
# DHARMA_TIBETAN_MODEL=openpecha/op-whisper_small-ft-v2

# Output directory (defaults to ./output)
# DHARMA_OUTPUT_DIR=/path/to/output

# Log directory (defaults to ./logs)
# DHARMA_LOG_DIR=/path/to/logs

# Confidence threshold for review queue (0.0-1.0)
# DHARMA_CONFIDENCE_THRESHOLD=0.5
